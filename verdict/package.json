{
  "name": "verdict-mvp",
  "version": "0.1.0",
  "private": true,
  "description": "Verdict MVP: PayPal 商家争议与退款证据核验（零外部依赖可试用版）",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3000",
    "demo": "node scripts/demo.mjs",
    "dev:phone": "next dev -H 0.0.0.0 -p 3000 --experimental-https",
    "build": "next build",
    "start": "next start -H 127.0.0.1 -p 3000",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eval": "node scripts/eval.mjs",
    "reset": "rm -rf .data && echo '已清空 .data，下次启动会重新生成演示数据'",
    "account-link": "node scripts/account-link.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "next": "^16.4.5",
    "pdfkit": "^0.20.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pdfkit": "^0.17.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
